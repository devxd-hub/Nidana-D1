# NIDANA Backend Environment Variables (Example Template)
# Copy to .env for local development. Never commit real credentials.

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME=NIDANA-Backend
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
# Production must NOT use *; list explicit frontend domains.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Access (PostgreSQL / Supabase Postgres)
# Example: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For local development or hermetic tests: sqlite:///./nidana_dev.db
DATABASE_URL=sqlite:///./nidana_dev.db

# Supabase Auth & JWT Configuration
# Required for server-side verification of learner access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Optional External AI/Observability Keys (Not utilized in MVP foundational routes)
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
