# ========================================================
# NIDANA Backend Environment Variables (Locked v2 Stack)
# ========================================================

# Application Lifecycle
APP_ENV=development
DEBUG=true
PORT=8000

# Authoritative Relational Database (SQLite)
# WARNING: Do not place SQLite files on ephemeral serverless filesystems.
# Mount a persistent volume in production (e.g., ./data/nidana.db).
SQLITE_DATABASE_URL=sqlite:///./data/nidana.db

# Vector Index (ChromaDB)
# Persistent local directory for rebuildable curriculum embeddings.
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=nidana_curriculum_chunks

# LLM Provider (Google Gemini)
# Provider-specific adapter. Optional in local/test-double mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT Authentication
# Secret used for server-side token signature verification.
SUPABASE_JWT_SECRET=nidana-dev-secret-key-32-chars-minimum-sample!!
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# CORS Allowed Origins (Comma-separated)
# In production, wildcards (*) are strictly rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Observability (Langfuse)
# Non-blocking; absence will never block startup or test execution.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
